From 1e9bc7991689252591d9392aff0d1e052a5db777 Mon Sep 17 00:00:00 2001
From: giedriuslt <123905703+giedriuslt@users.noreply.github.com>
Date: Fri, 31 Jul 2026 08:57:21 +0300
Subject: [PATCH] wifi_manager: honor ht_on module param in ME_CONFIG_REQ

bl_handle_dynparams() clears ht_cap.ht_supported when ht_on is false,
but nothing reads that flag: bl_send_me_config_req() hardcodes
req->ht_supp = 1, so the firmware (me_config_req_handler stores it into
me_env and gates all HT setup on it) always enables 802.11n and the
ht_on parameter is dead code.

Pass mod_params->ht_on through, making the compile-time disable-802.11n
switch actually work: with ht_on=false the device associates as a
legacy 11b/g client.
---
 components/network/wifi_manager/bl60x_wifi_driver/bl_msg_tx.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/components/network/wifi_manager/bl60x_wifi_driver/bl_msg_tx.c b/components/network/wifi_manager/bl60x_wifi_driver/bl_msg_tx.c
index 2256d3cf3..a6ae10a68 100644
--- a/components/network/wifi_manager/bl60x_wifi_driver/bl_msg_tx.c
+++ b/components/network/wifi_manager/bl60x_wifi_driver/bl_msg_tx.c
@@ -485,9 +485,9 @@ int bl_send_me_config_req(struct bl_hw *bl_hw)
     }
 
     /* Set parameters for the ME_CONFIG_REQ message */
-    bl_os_printf("[ME] HT supp %d, VHT supp %d\r\n", 1, 0);
+    bl_os_printf("[ME] HT supp %d, VHT supp %d\r\n", bl_hw->mod_params->ht_on, 0);
 
-    req->ht_supp = 1;
+    req->ht_supp = bl_hw->mod_params->ht_on;
     req->vht_supp = 0;
     req->ht_cap.ht_capa_info = cpu_to_le16(bl_hw->ht_cap.cap);
 
-- 
